# Copy to .env and fill values. Do NOT commit the real .env to git.
# Example .env keys used by the bot

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your-telegram-bot-token-here

# SafeCheck API credentials (get from https://ru.safecheck.online)
SAFECHECK_API_KEY=your-safecheck-api-key-here
SAFECHECK_USER_ID=your-safecheck-user-id-here

# SafeCheck API endpoint (usually no need to change)
SAFECHECK_ENDPOINT=https://ru.safecheck.online/api

# Your Telegram numeric user ID (owner/admin for /allow /revoke)
# Example: установите ваш ID (не токен!) — этот файл не должен содержать секретов
# Получить свой ID можно через @userinfobot
OWNER_ID=6781252224
